# ==============================================================================
# Power Unit Operator Simulator (React Frontend) — Environment Configuration
# ==============================================================================

# Локальный порт для запуска React-приложения (dev-сервер)
PORT=3001

# Адрес WebSocket-подключения к серверу симуляции ВВЭР-1200 (телеметрия 20 Гц)
REACT_APP_SIM_WS_URL=ws://localhost:3000

# Базовый HTTP URL REST API сервера симуляции
REACT_APP_SIM_HTTP_URL=http://localhost:3000
